# Frontend Environment Variables
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_WHOOP_CLIENT_ID=your_whoop_client_id_here
# Optional override: by default the redirect URI is built at runtime via
# Linking.createURL('whoop-callback'), which is the app's own registered
# scheme (see app.json). Only set this if you need to hardcode a specific URI.
EXPO_PUBLIC_WHOOP_REDIRECT_URI=your_redirect_uri_here
# NOTE: WHOOP_CLIENT_SECRET must never be set here (EXPO_PUBLIC_* vars ship in
# the client bundle). It lives in server/.env.example instead.
