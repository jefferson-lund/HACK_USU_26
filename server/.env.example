OPENAI_API_KEY=your_openai_api_key_here
PORT=4000

# WHOOP OAuth (server-side only -- WHOOP_CLIENT_SECRET must never be exposed
# to the client). Used by POST /api/whoop/token to exchange an authorization
# code for an access/refresh token pair.
WHOOP_CLIENT_ID=your_whoop_client_id_here
WHOOP_CLIENT_SECRET=your_whoop_client_secret_here
# Must match the redirect_uri the client actually used when requesting the
# authorization code. The client sends its redirect_uri with each token
# request, so this is only used as a fallback if that's ever omitted.
WHOOP_REDIRECT_URI=your_redirect_uri_here
